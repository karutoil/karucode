# karucode - self-hosted coding-agent harness.
#
# Install (this writes a drop-in with your workspace, data dir and binary path -
# see packaging/install.sh):
#     sudo sh install.sh --workspace /srv/karucode/workspace
#
# Install by hand:
#     install -m 0644 packaging/karucode.service /etc/systemd/system/karucode.service
#     install -d -m 0755 /etc/systemd/system/karucode.service.d
#     # ... then put WorkingDirectory=/ReadWritePaths= in a drop-in, not in this file
#     systemctl daemon-reload
#     systemctl enable --now karucode
#
# Do not edit the two paths below in place: install.sh rewrites the unit on every
# upgrade, and the file you edited is exactly the configuration that stops the
# service from starting afterwards. Site-specific settings belong in
# /etc/systemd/system/karucode.service.d/20-local.conf, which no tool touches.
#
# Before the first start, create /etc/karucode/karucode.env with the provider
# credentials (see packaging/README.md).
#
# =============================================================================
# A NOTE ON CONFINEMENT
# =============================================================================
#
# This unit deliberately does **not** sandbox the agent's filesystem. karucode
# runs the shell commands the model asks for with `/bin/sh -c <command>` as
# User=karucode, and it can write anywhere that user can - including your home
# directory, sibling checkouts and build caches. There is no `ProtectSystem=`, no
# `ProtectHome=` and no `ReadWritePaths=` allowlist to maintain: nothing the agent
# does fails with `EROFS`, and `mv`/`cp`/`rm` work across the filesystem.
#
# That is a deliberate trade. A read-only root is the strongest thing a unit file
# can do, but it makes the agent useless for the ordinary work of moving files
# around, and keeping the allowlist correct for every toolchain (cargo, npm, pnpm,
# bun, rustup, plugins, screenshots) turned out to be a permanent maintenance
# burden with a failure mode - `EROFS` deep inside a build - that looks like a bug
# in the tool rather than in the unit.
#
# What still bounds the agent:
#
#   User=karucode
#       A dedicated unprivileged account. Nothing it does can touch a file that
#       account cannot write, so running it as a *dedicated user* is the lever
#       that replaces the filesystem sandbox. Do not run this service as root.
#
#   NoNewPrivileges=yes
#       No setuid/setgid binaries, no file capabilities, no gaining privileges
#       through sudo or a helper. The agent cannot become root even if it finds a
#       local privilege-escalation vector that needs a privileged exec. This is
#       kept because it costs nothing and stops the worst outcome; it does not
#       restrict ordinary file writes.
#
#   The remaining Protect*=/Restrict*= lines
#       Kernel and device surface (kernel modules, tunables, clock, hostname,
#       SUID/SGID creation, namespaces, personality, @system-service syscalls),
#       not your files. They do not get in the way of normal work.
#
# If you *do* want a filesystem sandbox, add it yourself in
# /etc/systemd/system/karucode.service.d/20-local.conf, which no tool rewrites:
#
#     [Service]
#     ProtectSystem=strict
#     ProtectHome=read-only
#     ReadWritePaths=/srv/karucode/workspace /var/lib/karucode
#
# ...then `systemctl daemon-reload && systemctl restart karucode`. Expect to widen
# ReadWritePaths= as you add toolchains; and remember that `ProtectSystem=strict`
# is why an unqualified `mv` or `rm` outside those paths fails with `EROFS`.
#
# Neither the unit nor this project can protect you from a malicious model with
# the filesystem writable. The approval policy is a convenience, not a boundary.
# If you need real isolation, run karucode in a container or VM with only the
# project mounted (see the Dockerfile) - that is the only real isolation.

[Unit]
Description=karucode - self-hosted coding agent
Documentation=https://github.com/karutoil/karucode
# The server needs nothing else at boot; it opens SQLite and binds a port.
After=network-online.target
Wants=network-online.target
# Restart=on-failure without a start limit loops forever at boot when the unit
# cannot start (a missing workspace, a bad env file), and that is both a journal
# flood and a machine that looks busy but serves nothing. Five attempts per five
# minutes, then systemd gives up and reports the failure.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# --- identity ---------------------------------------------------------------
# `install.sh` writes `User=`/`Group=` into a drop-in, set to the account that ran
# it ($SUDO_USER, else $LOGNAME, else the session login uid), so a normal install
# runs the agent as *you*: your files, your toolchains, your `~/.cargo` and
# `~/.local/bin`. That is deliberate - the unit does not sandbox the filesystem
# (see the header), so a separate account buys no protection and only cuts the
# agent off from the tools it needs. Root is never written; the installer refuses
# it in every spelling.
#
# The values below are the fallback for a hand-installed unit, and for the narrow
# case of running the installer from a bare root shell where no human can be
# identified at all (the installer warns loudly when it takes that path).
# `karucode` is a system account; create it with:
#     useradd --system --home-dir /var/lib/karucode --shell /usr/sbin/nologin karucode
# Whatever the account, do NOT run this service as root: the agent executes
# arbitrary commands.
User=karucode
Group=karucode

# --- filesystem layout ------------------------------------------------------
# StateDirectory creates /var/lib/karucode (mode 0700, owned by karucode) and
# excludes it from ProtectSystem=strict. That is where the SQLite database
# (karucode.db, WAL) and plugin data live - and where the provider API key is
# stored, so treat it as a secret.
StateDirectory=karucode
StateDirectoryMode=0700
# ConfigurationDirectory creates /etc/karucode for karucode.env and an optional
# config.toml. It stays read-only for the service (ProtectSystem=strict); the
# environment file is read by systemd, not by the process.
ConfigurationDirectory=karucode

# Site default: the directory the agent may read and edit. It must already exist
# and be owned by the service user. install.sh creates it and overrides this in
# /etc/systemd/system/karucode.service.d/10-install.conf; keep it narrow (one
# project, never your home directory).
WorkingDirectory=/srv/karucode/workspace

# --- environment ------------------------------------------------------------
# The data dir must be the StateDirectory: the default is
# $HOME/.local/share/karucode, and $HOME is not writable under this unit.
Environment=KARUCODE_DATA_DIR=/var/lib/karucode
# Bind loopback and let a reverse proxy terminate TLS. The binary has no TLS of
# its own. If you must bind a non-loopback address, the server refuses to start
# without KARUCODE_AUTH_TOKEN (>= 16 chars) - set it in the env file below.
Environment=KARUCODE_HOST=127.0.0.1
Environment=KARUCODE_PORT=8787
# `-` = do not fail if the file is missing. Put KARUCODE_AUTH_TOKEN,
# KARUCODE_ADMIN_TOKEN, KARUCODE_BASE_URL, KARUCODE_API_KEY, KARUCODE_MODEL,
# KARUCODE_PROJECT_ROOTS, KARUCODE_ALLOWED_HOSTS and friends here, mode 0600.
# This file is read AFTER the Environment= lines above, so it can override them.
EnvironmentFile=-/etc/karucode/karucode.env

ExecStart=/usr/local/bin/karucode

# --- restart ----------------------------------------------------------------
# on-failure, not always: a clean exit (SIGTERM from `systemctl stop`) must stay
# stopped. The server drains gracefully on SIGTERM (bounded at 10s) and
# checkpoints SQLite, so give it room before the SIGKILL.
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# --- hardening --------------------------------------------------------------
# The agent's shell inherits all of this. See the header: the kernel/device
# surface is locked down, but the filesystem is deliberately left writable so the
# agent can do ordinary work. NoNewPrivileges= is what stops it becoming root.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# Rust does not need writable+executable memory, so this is safe for the server
# itself. Caveat: it also applies to the commands the agent runs, so JIT runtimes
# (node, the JVM, some Python C extensions) will crash with it enabled. If you
# expect the agent to run those, set this to `no` - you are trading a hardening
# knob for the ability to run JavaScript/Java at all.
MemoryDenyWriteExecute=yes
# @system-service is the standard allowlist for a long-running network service.
# It is broad enough for the usual build/test commands (fork/exec, file I/O,
# sockets) but blocks module loading and other kernel-level tricks. If a specific
# tool the agent needs trips it, check `journalctl -u karucode` for EPERM and add
# a narrow `SystemCallFilter=~@...` exception rather than removing the filter.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# No new privileges via user namespaces either.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
