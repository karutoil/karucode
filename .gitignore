target/
web/node_modules/
web/dist/
*.db
*.db-wal
*.db-shm
.data/
.env
.env.local
# Existing tracked reports remain versioned; new local reports are artifacts.
/reports/
exports/
.cache/
# the release job's `dist/${name}.tar.gz` + SHA256SUMS (CI only; never a checkout)
dist/

# local design mock: a single-file reference the theme engine was derived from,
# not a build input (the values live in web/src/theme/builtins.ts)
karucode-v3-themes.html
# branding sources ARE the build input for web/public favicons; only the
# rendered PNG size matrix and the social exports are generated
branding/png/
branding/social/*.png

# --- local state, never committed -------------------------------------------
# karucode's own state while developing karucode: the todo plugin's session
# files and attachments, the local server's data dir (SQLite, logs, the lock)
# and scratch screenshots. None of it is a build input.
.karucode/
.kc-data/
.audit/
# A working config copied from `config.example.toml` for a local run. The
# example is the versioned file; this one is where a real provider `api_key`
# ends up, and `KARUCODE_CONFIG=./config.toml` makes it a one-flag download of
# someone else's secret. Root-anchored so an example or demo app may still
# commit its own `config.toml`.
/config.toml

# --- tool output that is never a source file ---------------------------------
# The checks in this repo are mostly Python and Node: `python3 tests/...` and
# `npx vitest` are documented commands (AGENTS.md, .github/workflows/ci.yml), and
# they leave bytecode caches and a typecheck stamp behind. `packaging/install.sh`
# and `update.sh` also extract release tarballs into the tree during the e2e
# checks. None of it is an input to any build.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.tsbuildinfo

# --- scratch pages -----------------------------------------------------------
# `web/mock/` is where a hand-written page goes when a CSS question can only be
# answered by a real browser (does the rail render, what computed style wins).
# It loads stylesheets out of web/src by relative path and is referenced by no
# source, test or script — the answer comes back through the console, not the
# file. Never a build input.
web/mock/

# --- editor and patch debris -------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.orig
*.rej

node_modules/

# Design explorations, captures, and raw browser-verification output are local
# artifacts, not product source. The written verification report stays versioned.
/docs/mockups/
/docs/internal/design-verify/screens/
/docs/internal/design-verify/appearance-matrix.json
