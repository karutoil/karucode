# karucode environment variables
# Copy to .env and source it, or export these in your shell / unit file.

# --- server ---
# KARUCODE_HOST=127.0.0.1
# KARUCODE_PORT=8787
# KARUCODE_WORKSPACE=/home/me/project
# KARUCODE_DATA_DIR=$HOME/.local/share/karucode
# KARUCODE_CONFIG=$HOME/.config/karucode/config.toml
# KARUCODE_AUTH_TOKEN=change-me-to-16-plus-chars
# KARUCODE_ADMIN_TOKEN=change-me-too    # required to change approvals/model over the API
# KARUCODE_PROJECT_ROOTS=/home/me/projects:/srv/code   # colon-separated allowlist; default = any directory
# KARUCODE_ALLOW_TEMP_DIR=1            # 1 (default) = file tools may also use TMPDIR//tmp; 0 = project only
# KARUCODE_RETENTION_DAYS=0            # 0 = keep everything; N = prune messages older than N days
# KARUCODE_LOCK_SETTINGS=1
# KARUCODE_LOG=info,karucode=debug
# KARUCODE_WEB_DIR=./web/dist      # serve the UI from disk instead of the embed

# --- model (OpenAI-compatible) ---
# KARUCODE_MODEL=gpt-4o-mini
# Set to 1 when the model accepts image input; read_file then attaches PNG/JPEG/
# GIF/WebP pixels instead of refusing them.
# KARUCODE_MODEL_SUPPORTS_IMAGES=1
# KARUCODE_BASE_URL=http://127.0.0.1:4000/v1
# KARUCODE_API_KEY=sk-...
# KARUCODE_TEMPERATURE=0.2
# KARUCODE_MAX_TOKENS=4096
# KARUCODE_REQUEST_TIMEOUT_SECS=300
# KARUCODE_RETRY_MAX_TOTAL_SECS=300   # wall-clock ceiling for one stream's retries
# OPENAI_BASE_URL=...            # fallback when KARUCODE_BASE_URL is unset
# OPENAI_API_KEY=...             # fallback when KARUCODE_API_KEY is unset

# --- limits ---
# KARUCODE_MAX_ITERATIONS=200        # model turns per segment
# KARUCODE_MAX_RUN_SECS=86400        # hard wall clock for the whole run
# KARUCODE_AUTO_CONTINUE=true        # refresh the iteration budget, don't stop
# KARUCODE_MAX_CONTINUES=50          # how many refreshes one run may chain
# KARUCODE_MAX_TOOL_OUTPUT_BYTES=24000
# KARUCODE_COMMAND_TIMEOUT_SECS=120
# KARUCODE_MAX_FILE_READ_BYTES=200000
# Largest image handed to a vision model (bytes, default 4 MiB).
# KARUCODE_MAX_IMAGE_READ_BYTES=4194304
# KARUCODE_CONTEXT_MAX_CHARS=0     # 0 = derive the budget from the model's window

# --- approvals ---
# KARUCODE_APPROVAL_MODE=ask          # ask | ask_commands | auto | read_only
# KARUCODE_ALLOW_COMMANDS="rg,git status,cargo test"
# KARUCODE_APPROVAL_TIMEOUT_SECS=300

# --- subagents ---
# KARUCODE_SUBAGENT_CONCURRENCY=3
# KARUCODE_SUBAGENT_MAX_ITERATIONS=200   # model turns per segment
# KARUCODE_SUBAGENT_MAX_CONTINUES=60     # segment refreshes (0 = one-shot)
# KARUCODE_SUBAGENT_TIMEOUT_SECS=14400   # 4h wall clock for one task
# KARUCODE_ALLOW_RECURSIVE_SUBAGENTS=false
